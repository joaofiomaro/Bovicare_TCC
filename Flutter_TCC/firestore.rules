rules_version = '2';

// BoviCare — Regras de segurança do Firestore.
// Dados privados isolados por usuário (rebanho, vacinações, vendas, pesagens,
// perfil) e a coleção compartilhada `serviceCalls` (produtor ↔ veterinário).
// Publicar com: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{db}/documents {

    function isSignedIn() { return request.auth != null; }

    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Veterinário: lê o papel do próprio perfil (custa 1 leitura por avaliação).
    // O exists() evita erro de avaliação caso o perfil ainda não exista.
    function isVet() {
      return isSignedIn()
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'vet';
    }

    // ── Perfil do usuário ─────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid);
      // `role` é definido no cadastro e IMUTÁVEL depois — impede que um produtor
      // se autopromova a veterinário e acesse o pool de chamados alheios.
      allow update: if isOwner(uid)
                    && request.resource.data.role == resource.data.role;
      allow delete: if isOwner(uid);
    }

    // Subcoleções privadas (animals, vaccinations, sales, weighings).
    // Wildcard de NÍVEL ÚNICO ({collection}/{docId} = 2 segmentos): cobre os
    // documentos das subcoleções SEM casar o doc de perfil acima — caso
    // contrário um `allow write` recursivo (`{sub=**}`) anularia a
    // imutabilidade do `role` (vide teste de auto-promoção).
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if isOwner(uid);
    }

    // ── Chamados — coleção compartilhada produtor ↔ vet ───────────────────────
    match /serviceCalls/{callId} {
      // Produtor cria o próprio chamado, sempre aberto e sem vet pré-atribuído.
      allow create: if isOwner(request.resource.data.producerId)
                    && request.resource.data.status == 'open'
                    && !('vetId' in request.resource.data);

      // Leem: o produtor dono, o vet atribuído ou qualquer vet quando aberto (pool).
      allow read: if isOwner(resource.data.producerId)
                  || (isSignedIn() && resource.data.vetId == request.auth.uid)
                  || (resource.data.status == 'open' && isVet());

      allow update: if
        // Produtor cancela o próprio chamado enquanto ainda aberto.
        (isOwner(resource.data.producerId)
           && resource.data.status == 'open'
           && request.resource.data.status == 'cancelled'
           && request.resource.data.producerId == resource.data.producerId)
        // Vet aceita um chamado do pool (open → accepted, assume o vínculo).
        || (isVet()
           && resource.data.status == 'open'
           && request.resource.data.status == 'accepted'
           && request.resource.data.vetId == request.auth.uid
           && request.resource.data.producerId == resource.data.producerId)
        // Vet atribuído evolui o atendimento — sem alterar o vínculo nem os
        // dados de origem do produtor.
        || (isSignedIn()
           && resource.data.vetId == request.auth.uid
           && request.resource.data.vetId == resource.data.vetId
           && request.resource.data.producerId == resource.data.producerId
           && request.resource.data.producerName == resource.data.producerName);

      // Nunca deletar — histórico/auditoria.
      allow delete: if false;
    }
  }
}
