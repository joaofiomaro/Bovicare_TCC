# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env NÃO deve ser commitado no repositório.
#
# ATENÇÃO: o .env é empacotado como asset dentro do APK/IPA (flutter_dotenv).
# Portanto NUNCA coloque segredos aqui (chaves de API privadas, senhas, tokens):
# qualquer pessoa com o binário consegue ler. Apenas configuração pública.
#
# O app funciona sem este arquivo (usa os padrões abaixo), mas o build exige
# que ele exista — o run.ps1 cria uma cópia automaticamente.

# URL base da API REST (sem barra no final) — reservado, ainda não usado
API_BASE_URL=https://api.bovicare.com.br/v1

# URL do broker MQTT do brete (ESP32) — ex: ws://192.168.x.x:9001 (Fase 7)
MQTT_BROKER_URL=ws://SEU_IP_DO_ESP32:9001

# ID único do cliente MQTT para este app
MQTT_CLIENT_ID=bovicare_app

# Tile server do mapa de veterinários.
# O app usa flutter_map + OpenStreetMap — NÃO usa Google Maps e não precisa de
# chave de API. Só são aceitos templates https com {z}/{x}/{y}; qualquer outro
# valor cai no padrão do OSM. Política de uso: https://operations.osmfoundation.org/policies/tiles/
MAPS_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Ambiente da aplicação: development | staging | production
APP_ENV=development
